pipeline {
    agent any
    
    environment {
        DOCKER_HUB_CREDENTIALS = credentials('docker-hub-credentials')
        DOCKER_HUB_USERNAME = 'rahulraman'
        SERVICE_NAME = 'payment-service'
        IMAGE_NAME = "${{DOCKER_HUB_USERNAME}}/redbus-${{SERVICE_NAME}}:latest"
    }
    
    stages {
        stage('Build') {
            steps {
                echo "========== Building ${{SERVICE_NAME}} =========="
                dir("backend/${{SERVICE_NAME}}") {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }
        
        stage('Test') {
            steps {
                echo "========== Testing ${{SERVICE_NAME}} =========="
                dir("backend/${{SERVICE_NAME}}") {
                    sh 'mvn test'
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                echo "========== Building Docker Image for ${{SERVICE_NAME}} =========="
                dir("backend/${{SERVICE_NAME}}") {
                    sh "docker build -t ${{IMAGE_NAME}} ."
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                echo "========== Pushing ${{SERVICE_NAME}} to Docker Hub =========="
                sh '''
                    echo $DOCKER_HUB_CREDENTIALS_PSW | docker login -u $DOCKER_HUB_CREDENTIALS_USR --password-stdin
                    docker push ''' + "${IMAGE_NAME}" + '''
                    docker logout
                '''
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
        success {
            echo "✅ ${{SERVICE_NAME}} pipeline succeeded!"
        }
        failure {
            echo "❌ ${{SERVICE_NAME}} pipeline failed!"
        }
    }
}
